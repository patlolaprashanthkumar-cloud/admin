# IIECM Admin — Environment Variables Example
# Copy this file to .env and fill in your Supabase project credentials.
# NEVER commit your real .env file or share your service role key.

# Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (safe for frontend use — found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: The Supabase service role key must NEVER be exposed in frontend environment variables.
# It should only be used in server-side code or edge functions.
